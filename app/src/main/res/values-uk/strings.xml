    <!-- Onboarding-->
    <string name="onboarding_welcome_title">Ласкаво просимо до BVM</string>
    <string name="onboarding_welcome_message">Менеджер гучності Bluetooth дозволяє автоматично керувати гучністю пристроїв Bluetooth.</string>
    <string name="onboarding_welcome_action">Розпочинаймо</string>
    <string name="onboarding_beta_title">Бета-версія</string>
    <string name="onboarding_beta_message">Це бета-версія (тестова збірка). Використовуй з гумором і планом Б. Будь ласка, повідомляй про проблеми, які трапляються.</string>
    <string name="onboarding_beta_action">Я нічого не боюся</string>
    <string name="onboarding_privacy_title">Приватність і дані</string>
    <string name="onboarding_privacy_message">Менеджер гучності Bluetooth не містить реклами і не продає дані користувачів (навіть має відкритий код). Твоя приватність важлива для мене.</string>
    <string name="onboarding_privacy_read_action">Читати політику приватності</string>
    <string name="onboarding_privacy_action">Прийняти</string>
    <string name="onboarding_rewrite_title">Переписаний додаток!</string>
    <string name="onboarding_rewrite_message">Я повністю переписав Менеджер гучності Bluetooth з нуля через зміни в Android і вимоги Google, щоб додаток продовжував працювати стабільно.</string>
    <string name="onboarding_rewrite_features">Деякі налаштування пристроїв могли бути скинуті під час цього оновлення. Будь ласка, перевір конфігурації своїх пристроїв.</string>
    <string name="onboarding_rewrite_action">Продовжити</string>
    <!-- Discover -->
    <string name="discover_all_devices_managed_msg">Усі твої спарені пристрої вже керуються! Потрібен новий?</string>
    <string name="discover_pair_new_device_action">Спарити новий пристрій</string>
    <string name="discover_device_speaker_desc">Вбудований динамік телефону. Його гучність застосовується, коли звук переключається назад на телефон, наприклад, після відключення пристрою Bluetooth.</string>
