    <string name="onboarding_welcome_title">BVM ga xush kelibsiz</string>
    <string name="onboarding_welcome_message">Bluetooth Volume Manager Bluetooth qurilmalar ovozini avtomatik boshqarish imkonini beradi.</string>
    <string name="onboarding_welcome_action">Boshlaylik</string>
    <string name="onboarding_beta_title">Beta versiya</string>
    <string name="onboarding_beta_message">Bu beta (sinov) versiyasidir. Hazil tuyg\'usi va zaxira reja bilan davom eting. Iltimos, duch kelgan muammolarni xabar qiling.</string>
    <string name="onboarding_beta_action">Men hech narsadan qo\'rqmayman</string>
    <string name="onboarding_privacy_title">Maxfiylik va ma\'lumotlar</string>
    <string name="onboarding_privacy_message">Bluetooth Volume Manager reklama ko\'rsatmaydi va foydalanuvchi ma\'lumotlarini sotmaydi (u hatto ochiq kodli). Sizning maxfiyligingiz men uchun muhim.</string>
    <string name="onboarding_privacy_read_action">Maxfiylik siyosatini o\'qish</string>
    <string name="onboarding_privacy_action">Qabul qilish</string>
    <string name="onboarding_rewrite_title">Ilova yangilandi</string>
    <string name="onboarding_rewrite_message">Android o\'zgarishlari va Google talablariga moslashish uchun ilovani qayta yozishga to\'g\'ri keldi. Ilovani ishonchli ishlashda davom etishi uchun iloji boricha zamonaviylashtirdim.</string>
    <string name="onboarding_rewrite_features">Yangilanish jarayonida ba\'zi funksiyalar o\'zgardi. Hamma narsa to\'g\'ri sozlanganligini tekshirish uchun qurilma sozlamalarini ko\'rib chiqing.</string>
    <string name="onboarding_rewrite_action">Davom etish</string>
    <!-- Discover -->
    <string name="discover_all_devices_managed_msg">Barcha juftlashtirilgan qurilmalaringiz boshqarilmoqda! Yangi qurilma kerakmi?</string>
    <string name="discover_pair_new_device_action">Yangi qurilma juftlashtirish</string>
    <string name="discover_device_speaker_desc">Telefonning o\'z karnaysi. Uning ovoz darajalari audio telefonga qaytganda qo\'llaniladi, masalan, Bluetooth qurilmangiz uzilgandan keyin.</string>
