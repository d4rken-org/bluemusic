    <string name="devices_device_config_section_timing_label">Vaqt</string>
    <string name="devices_device_config_monitoring_duration_label">Monitoring davomiyligi</string>
    <string name="devices_device_config_monitoring_duration_desc">Sozlamalar amalga oshirilgandan keyin, keyingi ovoz o\'zgarishlari bloklanadigan millisoniyalardagi davomiylik.</string>
    <string name="devices_device_config_adjustment_delay_label">Sozlash kechikishi</string>
    <string name="devices_device_config_adjustment_delay_desc">Har bir ovoz sozlamasi orasidagi millisoniyalardagi kechikish. 0ms kechikish qurilma ulanganda ovozni darhol o\'rnatishni anglatadi.</string>
    <string name="devices_device_config_reaction_delay_label">Munosabat kechikishi</string>
    <string name="devices_device_config_reaction_delay_desc">Ushbu ilova qurilmaga munosabat bildirgunga qadar millisoniyalardagi kechikish.</string>
    <string name="devices_device_config_section_reaction_label">Munosabat</string>
    <string name="devices_device_config_launch_app_label">Ilovalarni ishga tushirish</string>
    <string name="devices_device_config_launch_app_desc">Bu qurilma ulanganda ilovalarni ishga tushirish.</string>
    <string name="devices_device_config_launch_app_multiple_desc">%d ta ilova tanlangan</string>
    <string name="devices_device_config_show_home_screen_label">Bosh ekranni ko\'rsatish</string>
    <string name="devices_device_config_show_home_screen_desc">Bu qurilma uchun barcha voqealar qayta ishlanganidan so\'ng, bosh ekranni ko\'rsatishga harakat qiladi. Bu Android ning barcha versiyalarida ishlamasligi mumkin.</string>
    <string name="devices_device_config_nudge_volume_label">Ovozni turtish</string>
    <string name="devices_device_config_nudge_volume_description">Tizim kerakli ovozni allaqachon o\'rnatgan bo\'lsa ham, ovozni bir qadam kamaytiradi, so\'ng ko\'taradi.</string>
    <string name="devices_device_config_visible_adjustments_label">Ko\'rinadigan sozlamalar</string>
    <string name="devices_device_config_visible_adjustments_desc">Bu ilova ushbu qurilma uchun sozlamalar amalga oshirayotganda tizimning ovoz oynasini ko\'rsatish.</string>
    <string name="devices_device_config_keep_awake_label">Uyg\'oq saqlash</string>
    <string name="devices_device_config_keep_awake_desc">Ilovani orqa fonda faol holatda saqlaydi, ulanганиda ovoz boshqaruvi ishlashda davom etadi va qurilma ulanganda ekranni uyg\'otadi (\"Boshqa ilovalar ustida ko\'rsatish\" ruxsati talab qilinadi). Android\'ning yangi versiyalarida ekran baribir o\'z-o\'zidan o\'chib qolishi mumkin.</string>
    <string name="devices_device_config_volume_observe_label">O\'zgarishlarni kuzatish</string>
    <string name="devices_device_config_volume_observe_desc">Bu qurilma ulanganda faol bo\'lib turib, ushbu ilova tomonidan amalga oshirilmagan ovoz o\'zgarishlarini saqlash.</string>
    <string name="devices_device_config_volume_save_on_disconnect_label">Uzilganda ovozni saqlash</string>
    <string name="devices_device_config_volume_save_on_disconnect_desc">Bu qurilma uzilganda joriy ovoz darajalarini olish va saqlash.</string>
    <string name="devices_device_config_volume_save_on_disconnect_hint">Ba\'zi qurilmalarda tizim ovoz balandligini o\'qishdan oldin audio marshrutni almashtiradi. Agar saqlangan qiymatlar siz o\'rnatgan qiymatga mos kelmasa, uning o\'rniga \"Ovoz balandligi o\'zgarishlarini kuzatish\" opsiyasini yoqib ko\'ring.</string>
    <string name="devices_device_config_volume_lock_label">Ovoz qulfi</string>
    <string name="devices_device_config_volume_lock_desc">Bu qurilma ulanganda ushbu ilova orqali amalga oshirilmagan barcha ovoz o\'zgarishlari bekor qilinadi.</string>
    <string name="devices_device_config_volume_lock_override_desc">Ovoz qulfi hozirda bu funksiyani bekor qilmoqda.</string>
    <string name="devices_device_config_volume_limit_label">Ovoz chegarasi</string>
    <string name="devices_device_config_volume_limit_desc">Ushbu qurilmaning ovozini ma\'lum oraliqda saqlang, masalan, hech qachon 50% dan yuqori bo\'lmasin.</string>
    <string name="devices_device_config_volume_limit_stream_label">%1$s uchun chegara</string>
    <string name="devices_device_config_volume_limit_range_desc">%1$d%% va %2$d%% orasida</string>
    <string name="devices_device_config_volume_limit_min_desc">Kamida %1$d%%</string>
    <string name="devices_device_config_volume_limit_max_desc">Eng ko\'p %1$d%%</string>
    <string name="devices_device_config_volume_limit_unset_desc">Chegara o\'rnatilmagan</string>
    <string name="devices_volume_limit_screen_title">Ovoz chegarasi</string>
    <string name="devices_volume_limit_disabled_hint">O\'chirilgan, sizning chegaralaringiz saqlanadi, lekin hali qo\'llanilmaydi.</string>
    <string name="devices_volume_limit_band_bar_desc">Ruxsat qilingan ovoz oralig\'i</string>
    <string name="devices_volume_limit_no_streams_msg">Ushbu qurilma hali hech qanday ovozni boshqarmaydi. Uning uchun chegara o\'rnatash uchun qurilma sozlamalarida \"Ovoz\" ostida birini yoqing.</string>
    <string name="devices_device_config_volume_rate_limiter_label">Ovoz tezligi cheklagichi</string>
    <string name="devices_device_config_volume_rate_limiter_desc">Tez yoki haddan ziyod ovoz o\'zgarishlarining oldini olish uchun ovoz o\'zgarishlari chastotasini cheklash.</string>
