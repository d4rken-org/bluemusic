    <!-- Settings/Support-->
    <string name="settings_support_label">ஆதரவு</string>
    <string name="settings_support_description">ஆவணங்களை படிக்கவும், பிழைகளை அறிக்க செய்யவும், மற்றவர்களுடன் உரையாடவும் அல்லது debug logs ஐ பதிவு செய்யவும்.</string>
    <string name="settings_support_wiki_label">ஆவணம்</string>
    <string name="settings_support_wiki_description">BVM-அன்னை எற்பட்தாக பயன்படுத்துவது எப்படி என்று அறிக்கவும்</string>
