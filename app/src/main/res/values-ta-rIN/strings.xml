    <!-- Onboarding-->
    <string name="onboarding_welcome_title">BVM-க்கு வரவேற்கிறோம்</string>
    <string name="onboarding_welcome_message">Bluetooth Volume Manager உங்கள் Bluetooth சாதன ஒலி அளவை தானாகவே நிர்வகிக்க உதவுகிறது.</string>
    <string name="onboarding_welcome_action">தொடங்குவோம்</string>
    <string name="onboarding_beta_title">பீட்டா பதிப்பு</string>
    <string name="onboarding_beta_message">இது ஒரு பீட்டா (சோதனை) உருவாக்கம். நகைச்சுவை உணர்வு மற்றும் மாற்று திட்டத்துடன் தொடரவும். நீங்கள் சந்திக்கும் சிக்கல்களைப் புகாரளிக்கவும்.</string>
    <string name="onboarding_beta_action">நான் எதற்கும் பயப்படவில்லை</string>
    <string name="onboarding_privacy_title">தனியுரிமை &amp; தரவு</string>
    <string name="onboarding_privacy_message">Bluetooth Volume Manager-ல் விளம்பரங்கள் இல்லை மற்றும் பயனர் தரவை விற்கவில்லை (இது திறந்த மூலமாகும்). உங்கள் தனியுரிமை எனக்கு முக்கியம்.</string>
    <string name="onboarding_privacy_read_action">தனியுரிமைக் கொள்கையைப் படிக்கவும்</string>
    <string name="onboarding_privacy_action">ஏற்கு</string>
    <string name="onboarding_rewrite_title">ஆப் நவீனமாக்கப்பட்டது</string>
    <string name="onboarding_rewrite_message">Android மாற்றங்கள் மற்றும் Google தேவைகளுக்கு ஏற்பட்டாக ஆப்்அன்னை மூளை நான் முழுமையாக எழுதினேன். நம்பகமாக தொடரந்து இயங்கப்பட இயலுமிடத்தில் ஆப்்அன்னை நவீனப்படுத்திகிறேன்.</string>
    <string name="onboarding_rewrite_features">மேம்பாடு மூலம் சில விஷயங்கள் மாறியுள்ளன. அந்த விஷயங்கள் சரியாக அமைக்கப்பட்டுள்ளதாக உறுதிப்படுத்த உங்கள் சாதன அமைப்புகளைச் செக்கவும்.</string>
    <string name="onboarding_rewrite_action">தொடர்</string>
    <!-- Discover -->
    <string name="discover_all_devices_managed_msg">உங்கள் எல்லா இணைக்கப்பட்ட சாதனங்களும் நிர்வகிக்கப்படுகின்றன! புதிதாக ஒன்று தேவையா?</string>
    <string name="discover_pair_new_device_action">புதிய சாதனத்தை இணைக்கவும்</string>
    <string name="discover_device_speaker_desc">இந்த ஃபோனின் சொந்த ஸ்பீக்கர். ஆடியோ ஃபோனுக்கு மீண்டும் மாறும் போது அதன் ஒலிகள் பயன்படுத்தப்படுகிறது, எ.கா. உங்கள் ப்ளூடூத் சாதனம் துண்டிக்கப்பட்ட பின்னர்.</string>
    <!-- Devices -->
    <string name="devices_device_config_label">சாதன அமைப்பு</string>
    <string name="devices_device_config_remove_device_label">சாதனத்தை மறந்துவிடு</string>
    <string name="devices_device_config_remove_device_action">மறந்துவிடு</string>
    <string name="devices_device_config_remove_device_confirmation">%s-அய் நிர்வகிக்கப்பட்ட சாதனங்களிலிருந்து மறந்துவிடலாமா?</string>
    <string name="devices_device_config_rename_device_action">மறுபெயரிடு</string>
    <string name="devices_device_config_enabled_label">இயக்கப்பட்ட</string>
    <string name="devices_device_config_enabled_desc">இந்த சாதனம் இணைக்கப்பட்டால் ப்ரதிகிரியுங்கள்</string>
    <string name="devices_device_config_equalizer_label">ஈக்வலைசர்</string>
    <string name="devices_device_config_equalizer_desc">இந்தச் சாதனத்திற்கான ஈகுவலைசர் பேண்டுகளையும் ஒலியளவு பூஸ்டையும் சரிசெய்யவும். Android இன் சிஸ்டம் ஈகுவலைசரை ஆதரிக்கும் இசைப் பயன்பாடுகளுடன் மட்டுமே இது செயல்படும்.</string>
    <string name="devices_device_config_equalizer_boost_label">ஒலியளவு பூஸ்ட்: %1$s</string>
    <string name="devices_device_config_section_timing_label">நேரம்</string>
    <string name="devices_device_config_monitoring_duration_label">கண்காணிப்பு காலஅளவு</string>
    <string name="devices_device_config_monitoring_duration_desc">சரிசெய்த்தல்கள் மேற்கொள்ளப்பட்ட பிறகு, கூடுதலான ஒலி அளவு மாற்றங்கள் தடுக்கப்படும் மில்லிவிநாடிகளில் காலஅளவு.</string>
    <string name="devices_device_config_adjustment_delay_label">சரிசெய்த்தல் தாமதம்</string>
    <string name="devices_device_config_adjustment_delay_desc">ஒவ்வொரு ஒலி அளவு சரிசெய்த்தல்கும் இடையிலான மில்லிவிநாடிகளில் தாமதம். 0ms தாமதம் இந்த சாதனம் இணைக்கப்படும்போது உடனடியாக ஒலி அளவு அமைக்கப்படும் என்பதைக் குறிக்கிறது.</string>
    <string name="devices_device_config_reaction_delay_label">ப்ரதிகிரியிற்கு தாமதம்</string>
    <string name="devices_device_config_reaction_delay_desc">இந்த ஆப்் இந்த சாதனத்திற்கு ப்ரதிகிரிக்கும் வரையிலான மில்லிவிநாடிகளில் தாமதம்.</string>
    <string name="devices_device_config_section_reaction_label">ப்ரதிகிரியிற்கு</string>
    <string name="devices_device_config_launch_app_label">ஆப்களை தொடங்கு</string>
    <string name="devices_device_config_launch_app_desc">இந்த சாதனம் இணைக்கப்படும்போது ஆப்களை தொடங்கு.</string>
    <string name="devices_device_config_launch_app_multiple_desc">%d ஆப்கள் தேர்ந்தெடுக்கப்பட்டன</string>
    <string name="devices_device_config_show_home_screen_label">இல்ல திரையைக் காட்டு</string>
    <string name="devices_device_config_show_home_screen_desc">இந்த சாதனத்திற்கான அனைத்து நிகழ்வுகளும் செயலாக்கப்பட்ட பிறகு இல்ல திரையைக் காட்ட முயற்சிக்கும். இது அனைத்து Android பதிப்புகளிலும் இயங்காது.</string>
    <string name="devices_device_config_nudge_volume_label">ஒலி அளவை நகர்த்து</string>
    <string name="devices_device_config_nudge_volume_description">கணினியில் இல்லாமல் ஒலி அளவை ஒரு மட்டம் குறைத்து பின் உயர்த்துகிறது, என்பது கேட்டப்பட்ட ஒலி அளவு ஏற்கனவே அமைக்கப்பட்டிருந்தாலும் (கணினியின் படி).</string>
    <string name="devices_device_config_visible_adjustments_label">காணும் சரிசெய்த்தல்கள்</string>
    <string name="devices_device_config_visible_adjustments_desc">இந்த ஆப்் இந்த சாதனத்திற்காக சரிசெய்த்தல்கள் செய்யும்போது கணினியின் ஒலி சாளர்த்தைக் காட்டு.</string>
    <string name="devices_device_config_keep_awake_label">விழிப்பாக வை</string>
    <string name="devices_device_config_keep_awake_desc">இணைக்கப்பட்டுள்ளபோது ஆப்ஸை பின்னணியில் விழிப்புடன் வைத்திருக்கிறது, இதன் மூலம் ஒலி அளவு கட்டுப்பாடு செயல்படுகிறது, மேலும் சாதனம் இணையும்போது திரையை விழிப்புடன் வைக்கிறது (\"மற்ற ஆப்ஸ் மீது காண்பி\" அனுமதி தேவை). புதிய Android பதிப்புகளில் திரை தன்னைத்தானே முடக்கப்படலாம்.</string>
    <string name="devices_device_config_volume_observe_label">மாற்றங்களைக் கவனி</string>
    <string name="devices_device_config_volume_observe_desc">இந்த சாதனம் இணைக்கப்பட்டிருக்கும்போது உல்னிலையிருக்கும் மற்றும் இந்த ஆப்்இனால் ஏற்படாத ஒலி மாற்றங்களை சேமிக்கும்.</string>
    <string name="devices_device_config_volume_save_on_disconnect_label">தொடர்பு துணிக்கத்தில் ஒலி அளவை சேமி</string>
    <string name="devices_device_config_volume_save_on_disconnect_desc">இந்த சாதனம் தொடர்பு துணிக்கப்படும்போது தற்போதுள்ள ஒலி அளவுகளைக் குறித்து சேமிக்கும்.</string>
    <string name="devices_device_config_volume_save_on_disconnect_hint">சில சாதனங்களில், நாங்கள் ஒலி அளவுகளை படிக்கும் முன்பே கணினி ஆடியோ ரூட்டிங்கை மாற்றிவிடும். சேமிக்கப்பட்ட மதிப்புகள் நீங்கள் அமைத்தவற்றுடன் பொருந்தவில்லை என்றால், பதிலாக \"ஒலி அளவு மாற்றங்களை கவனி\" என்பதை இயக்க முயற்சிக்கவும்.</string>
    <string name="devices_device_config_volume_lock_label">ஒலி பூட்டு</string>
    <string name="devices_device_config_volume_lock_desc">இந்த சாதனம் இணைக்கப்பட்டிருக்கும்போது இந்த ஆப் அன்றி மாற்றப்பட்ட ஒலி மாற்றங்கள் உதாரணமாக மாற்றப்படும்.</string>
    <string name="devices_device_config_volume_lock_override_desc">தொகுதி பூட்டு தற்போது இந்த அம்சத்தை மேலெழுதுகிறது.</string>
    <string name="devices_device_config_volume_limit_label">ஒலியளவு வரம்பு</string>
    <string name="devices_device_config_volume_limit_desc">இந்தச் சாதனத்தின் ஒலியளவை ஒரு வரம்பிற்குள் வைத்திருங்கள், எடுத்துக்காட்டாக 50%-க்கு மேல் இருக்காதவாறு.</string>
    <string name="devices_device_config_volume_limit_stream_label">%1$s க்கான வரம்பு</string>
    <string name="devices_device_config_volume_limit_range_desc">%1$d%% முதல் %2$d%% வரை</string>
    <string name="devices_device_config_volume_limit_min_desc">குறைந்தது %1$d%%</string>
    <string name="devices_device_config_volume_limit_max_desc">அதிகபட்சம் %1$d%%</string>
    <string name="devices_device_config_volume_limit_unset_desc">வரம்பு அமைக்கப்படவில்லை</string>
    <string name="devices_volume_limit_screen_title">ஒலியளவு வரம்பு</string>
    <string name="devices_volume_limit_disabled_hint">முடக்கப்பட்டுள்ளது, உங்கள் வரம்புகள் சேமிக்கப்பட்டுள்ளன, ஆனால் இன்னும் பயன்படுத்தப்படாது.</string>
    <string name="devices_volume_limit_band_bar_desc">அனுமதிக்கப்பட்ட ஒலியளவு வரம்பு</string>
    <string name="devices_volume_limit_no_streams_msg">இந்தச் சாதனம் இன்னும் எந்த ஒலியளவையும் நிர்வகிக்கவில்லை. அதற்கு வரம்பு அமைக்க, சாதன அமைப்புகளில் \"ஒலியளவு\" என்பதன் கீழ் ஒன்றை இயக்கவும்.</string>
    <string name="devices_device_config_volume_rate_limiter_label">ஒலி விகித கட்டுப்பாடு</string>
    <string name="devices_device_config_volume_rate_limiter_desc">விரைவாக மற்றும் அதிகமாக ஒலி சரிசெய்த்தல்களைத் தடுக்க ஒலி மாற்றங்களின் அலைவீச்சைக் கட்டுப்படுத்து.</string>
    <string name="devices_device_config_volume_rate_limit_increase_duration_label">ஒலி ஐர்த்தல் தாமதம்</string>
    <string name="devices_device_config_volume_rate_limit_increase_duration_desc">ஒலி ஐர்த்தல்களுக்கும் இடையிலான குறைந்தபட்ச நேரம்: %d ms</string>
    <string name="devices_device_config_volume_rate_limit_decrease_duration_label">ஒலி குறைய்தல் தாமதம்</string>
    <string name="devices_device_config_volume_rate_limit_decrease_duration_desc">ஒலி குறைய்தல்களுக்கும் இடையிலான குறைந்தபட்ச நேரம்: %d ms</string>
    <string name="devices_device_config_autoplay_label">தானியங்கு இசைப்பிச்சு</string>
    <string name="devices_device_config_autoplay_desc">இந்த சாதனம் இணைக்கப்படும்போது கட்டமைக்கப்பட்ட மீடியா கீ கட்டளைகளை அனுப்பு.</string>
    <string name="devices_device_config_autoplay_keycodes_title">தானியங்கி இயக்க கட்டளைகள்</string>
    <string name="devices_device_config_autoplay_keycodes_order">கட்டளை வரிசை</string>
    <string name="devices_device_config_autoplay_keycodes_label">கட்டளைகள்</string>
    <string name="devices_device_config_autoplay_keycodes_none_set">கட்டளைகள் எதுவும் அமைக்கப்படவில்லை</string>
    <string name="devices_device_config_autoplay_keycodes_add_action">கட்டளை சேர்க்கவும்</string>
    <string name="devices_device_config_autoplay_keycodes_max_reached">அதிகபட்சம் %1$d கட்டளைகள்</string>
