    <string name="devices_device_config_nudge_volume_label">Cutucar volume</string>
    <string name="devices_device_config_nudge_volume_description">Diminui e depois aumenta o volume em um incremento, mesmo que o volume desejado já esteja definido (segundo o sistema).</string>
