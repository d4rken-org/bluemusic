    <string name="devices_device_config_monitoring_duration_desc">Una durada in millisecundos, dòpo chi sunt fatos sos aggiustamentos, durante sa cale calsiasi àteru cambiu de volume serà bloccàdu.</string>
    <string name="devices_device_config_adjustment_delay_label">Ritàrdu de aggiustamentu</string>
    <string name="devices_device_config_adjustment_delay_desc">Su ritàrdu in millisecundos intre cada aggiustamentu de volume. Un ritàrdu de 0ms vùltat a pònnere su volume a subitu cando su dispositivu si connèttet.</string>
    <string name="devices_device_config_reaction_delay_label">Ritàrdu de reatzzione</string>
    <string name="devices_device_config_reaction_delay_desc">Su ritàrdu in millisecundos finas a cando s\'app reagessi a custu dispositivu.</string>
    <string name="devices_device_config_section_reaction_label">Reatzzione</string>
    <string name="devices_device_config_launch_app_label">Làntziat apps</string>
