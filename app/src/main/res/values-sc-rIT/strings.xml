    <string name="devices_device_config_launch_app_multiple_desc">%d apps seletziòndas</string>
    <string name="devices_device_config_show_home_screen_label">Amostra sa pantalla printzipale</string>
    <string name="devices_device_config_show_home_screen_desc">Dòpo chi todos sos eventos sunt processados pro custu dispositivu, prova a amostare sa pantalla printzipale. Custu podet non funtzionare in tùdas sas versiones de Android.</string>
    <string name="devices_device_config_nudge_volume_label">Impùlsa su volume</string>
    <string name="devices_device_config_nudge_volume_description">Abbàssa e poi àltzat su volume de unu incremendu, fintzas si su volume desideràdu est già impostàdu (segundu su sistema).</string>
    <string name="devices_device_config_visible_adjustments_label">Aggiustamentos visìbbiles</string>
    <string name="devices_device_config_visible_adjustments_desc">Amostra sa finestra de volume de su sistema mentre s\'app fàchet aggiustamentos pro custu dispositivu.</string>
    <string name="devices_device_config_keep_awake_label">Teni in veglia</string>
    <string name="devices_device_config_keep_awake_desc">Mantènet l\'app dischida in su background mentras est connetída gosi su controlèu de su volumene sighit a funtzionare, e ischidat sa schermida cando unu dispositivu si connectat (necessítat sa permissione \"Mustrare subra de áteras apps\"). In sas versiones prus noas de Android sa schermida podet galu si studare a solía.</string>
    <string name="devices_device_config_volume_observe_label">Osserva sos cambios</string>
    <string name="devices_device_config_volume_observe_desc">Remàni ativu mentre custu dispositivu est connètidu e sàlva sos cambios de volume chi non sunt istados causàdos dae s\'app.</string>
    <string name="devices_device_config_volume_save_on_disconnect_label">Sàlva su volume a disconnessione</string>
    <string name="devices_device_config_volume_save_on_disconnect_desc">Càptura e sàlva sos livèllos de volume attuales cando su dispositivu si disconnèttet.</string>
    <string name="devices_device_config_volume_save_on_disconnect_hint">In calicunu dispositivu, su sistema cambiat su rutamentu de s\'àudio prima chi nois podimus lèghere sos volumes. Si sos valores salvados non currispondent a cussos chi ti ses postu, proa a abilitare \"Observa sos cambios de volume\" in su logu suu.</string>
    <string name="devices_device_config_volume_lock_label">Bloccu de volume</string>
    <string name="devices_device_config_volume_lock_desc">Calsiasi cambiu de volume non fatu tramite s\'app serrà reversìdu mentre custu dispositivu est connètidu.</string>
    <string name="devices_device_config_volume_lock_override_desc">Su blocu de volume annullat custu funtzionamentu in custu momentu.</string>
