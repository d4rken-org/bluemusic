    <string name="devices_device_config_section_timing_label">Isikhathi</string>
    <string name="devices_device_config_monitoring_duration_label">Isikhathi sokuqapha</string>
    <string name="devices_device_config_monitoring_duration_desc">Isikhathi ngamamillisekhensi, ngemuva kokwenziwa kokuhlela, lapho izinguquko ezinye zamavolumu zizovalwa.</string>
    <string name="devices_device_config_adjustment_delay_label">Ukubambezeleka kokuhlela</string>
    <string name="devices_device_config_adjustment_delay_desc">Ukubambezeleka ngamamillisekhensi phakathi kokuhlela okulandelana kwamavolumu. Ukubambezeleka kwe-0ms kusho ukusetha ivolumu masinyane uma le divayisi ixhuma.</string>
    <string name="devices_device_config_reaction_delay_label">Ukubambezeleka kwempendulo</string>
    <string name="devices_device_config_reaction_delay_desc">Ukubambezeleka ngamamillisekhensi kuze lolu hlelo lusheshe lungaphenduli kule divayisi.</string>
    <string name="devices_device_config_section_reaction_label">Impendulo</string>
    <string name="devices_device_config_launch_app_label">Vula izinhlelo</string>
    <string name="devices_device_config_launch_app_desc">Vula izinhlelo uma le divayisi ixhuma.</string>
    <string name="devices_device_config_launch_app_multiple_desc">Izinhlelo ezikhethi %d</string>
    <string name="devices_device_config_show_home_screen_label">Bonisa isikrini sasekhaya</string>
    <string name="devices_device_config_show_home_screen_desc">Ngemuva kokucutshungulwa kwezigameko zonke zale divayisi, zama ukubonisa isikrini sasekhaya. Lokhu kungase kungasebenzi kuzo zonke izinguqulo ze-Android.</string>
    <string name="devices_device_config_nudge_volume_label">Chukumisa ivolumu</string>
    <string name="devices_device_config_nudge_volume_description">Wehlisa bese uphakamisa ivolumu ngokwanda okukodwa, ngisho noma ivolumu efunekayo isekhona (ngokwesistem).</string>
    <string name="devices_device_config_visible_adjustments_label">Ukuhlela okubonakalayo</string>
    <string name="devices_device_config_visible_adjustments_desc">Bonisa ifasitela lamavolumu alesistem ngenkathi lolu hlelo lwehlisa ivolumu yale divayisi.</string>
    <string name="devices_device_config_keep_awake_label">Gcina iphapheme</string>
    <string name="devices_device_config_keep_awake_desc">Igcina uhlelo lokusebenza luvukile ngemuva ngenkathi luxhunyiwe ukuze ukulawulwa komsindo kuqhubeke kusebenza, futhi ivuse isikrini uma idivayisi ixhumeka (kudinga imvume \"Bonisa phezu kwezinye izinhlelo\"). Kuzinguqulo ze-Android ezintsha isikrini singase sicime ngokwaso.</string>
    <string name="devices_device_config_volume_observe_label">Buka izinguquko</string>
    <string name="devices_device_config_volume_observe_desc">Hlala usebenza ngenkathi le divayisi ixhunyiwe futhi ulondoloze izinguquko zamavolumu ezingenziwanga ngalolu hlelo.</string>
    <string name="devices_device_config_volume_save_on_disconnect_label">Londoloza ivolumu uma inqumeka</string>
    <string name="devices_device_config_volume_save_on_disconnect_desc">Thatha futhi ulondoloze amazinga amavolumu angaleso sikhathi uma le divayisi inqumeka.</string>
    <string name="devices_device_config_volume_save_on_disconnect_hint">Kudivayisi ezithile, uhlelo lushintsha ukuhamba komsindo ngaphambi kokuba sikwazi ukufunda ivolumu. Uma amanani agciniwe engafani nalokho owakusetha, zama ukuvula \"Buka izinguquko zeVolumu\" esikhundleni salokho.</string>
    <string name="devices_device_config_volume_lock_label">Ukuvala ivolumu</string>
    <string name="devices_device_config_volume_lock_desc">Noma yiziphi izinguquko zamavolumu ezingenziwanga ngalolu hlelo zizobuyiselwa ngenkathi le divayisi ixhunyiwe.</string>
    <string name="devices_device_config_volume_lock_override_desc">Ukukhiya kwamazwi manje kweqile lesi sici.</string>
    <string name="devices_device_config_volume_limit_label">Umkhawulo wevolumu</string>
    <string name="devices_device_config_volume_limit_desc">Gcina ivolumu yale divayisi ngaphakathi kobubanzi, isibonelo, ayisoze ibe phakamile kungo-50%.</string>
