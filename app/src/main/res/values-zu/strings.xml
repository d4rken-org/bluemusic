    <string name="devices_device_config_equalizer_label">I-Equalizer</string>
    <string name="devices_device_config_equalizer_desc">Lungiselela ibhendi ye-equalizer kanye nokukhulisa ivolumu ngalesisitho. Isebenza kuphela ngezinhlelo zokuhlabelela ezisekela i-equalizer yesistimu ye-Android.</string>
