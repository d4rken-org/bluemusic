    <!-- Onboarding-->
    <string name="onboarding_welcome_title">Wamukelwa ku-BVM</string>
    <string name="onboarding_welcome_message">I-Bluetooth Volume Manager ikuvumela ukuphatha amavolumu amadivayisi e-Bluetooth ngokuzenzakalelayo.</string>
    <string name="onboarding_welcome_action">Asiqale</string>
    <string name="onboarding_beta_title">Inguqulo ye-Beta</string>
    <string name="onboarding_beta_message">Lena iwukwakha kwe-beta (ukuhlola). Qhubeka ngokunye kohleko kanye nesu lokweseka. Sicela ubike izinkinga ozibona.</string>
    <string name="onboarding_beta_action">Angesesabi lutho</string>
    <string name="onboarding_privacy_title">Ubumfihlo &amp; Idatha</string>
    <string name="onboarding_privacy_message">I-Bluetooth Volume Manager ayinazo izikhangiso futhi ayithengisi idatha yabasebenzisi (ikhishwa njengomsombuluzo ovu-source). Ubumfihlo bakho bubalulekile kimi.</string>
    <string name="onboarding_privacy_read_action">Funda Inqubomgomo Yobumfihlo</string>
    <string name="onboarding_privacy_action">Yamukela</string>
    <string name="onboarding_rewrite_title">Uhlelo Lwenzelwe Kabusha</string>
    <string name="onboarding_rewrite_message">Ngadinga ukubhala kabusha uhlelo ukuze ngilandele izinguquko ze-Android nezidingo ze-Google. Ngenzelwe kabusha uhlelo lapho kunokwenzeka ukuqinisekisa ukuthi luqhubeka lusebenza ngokwethembeka.</string>
    <string name="onboarding_rewrite_features">Ezinye izici ziguqukile ngesikhathi sokubuyekeza. Sicela uhlole izilungiselelo zedivayisi yakho ukuqinisekisa ukuthi konke kulungiselwe ngendlela efanele.</string>
    <string name="onboarding_rewrite_action">Qhubeka</string>
    <!-- Discover -->
    <string name="discover_all_devices_managed_msg">Wonke amadivayisi akho asebenzisana nawo aphathwa! Udinga elisha?</string>
    <string name="discover_pair_new_device_action">Hlanganisa idivayisi entsha</string>
    <string name="discover_device_speaker_desc">Isahluko sefowuni sayo. Umthwali waso usetshenziswa lapho umsindo ubuya efowunini, isibonelo, emva kokuthi isixwayiso sakho se-Bluetooth siqedele ukunxibelelana.</string>
